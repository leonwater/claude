{
  "name": "study-quiz-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "파일을 넣으면 원문 그대로 객관식 문제를 만들어 주는 개인용 학습 PWA",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && CAP_BUILD=1 vite build && cap sync android",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && node e2e/builtin.mjs && node e2e/upload.mjs",
    "bank": "python3 tools/adsp-bank/make_bank.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
